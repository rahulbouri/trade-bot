# AgentQuant Environment Configuration
# Copy this file to .env and fill in your API keys.
# In Railway: set these in the Railway dashboard → Variables tab.

# ── Required ──────────────────────────────────────────────────────────────────
# Google Gemini — LLM analysis of trade candidates (LLM analysis node)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# OpenAI fallback (used if Gemini unavailable)
OPENAI_API_KEY=

# FRED macroeconomic data (skip if not using FRED features)
# Get at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Logging level (INFO / DEBUG / WARNING)
LOG_LEVEL=INFO

# ── Set automatically by Railway — do not change ──────────────────────────────
# PORT=8501
